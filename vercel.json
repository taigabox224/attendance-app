{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/__api_not_on_vercel" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
