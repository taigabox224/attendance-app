# ───── Server ─────
PORT=3000
NODE_ENV=development
# フロントの URL(認証メールに埋め込む。dev は Vite の dev server)
APP_URL=http://localhost:5173

# ───── Database ─────
# MVP は SQLite。better-sqlite3 が直接ファイルパスを開くので、
# アプリ側で `file:` プレフィックスを剥がして使う想定。
# 本番で PostgreSQL に移行する場合は postgres://user:pass@host:5432/attendance に置き換え。
DATABASE_URL=file:./data/app.db

# ───── CORS ─────
# カンマ区切り、ブラウザの Origin と完全一致した時だけ許可。
# Phase 1 (python http.server 8000) と Phase 2 (Vite 5173) の両方を許容。
# 本番で同一オリジン配信なら空でも可。
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ───── JWT ─────
# 本番投入前に `openssl rand -hex 64` で再生成すること
JWT_SECRET=replace-me-run-openssl-rand-hex-64
JWT_EXPIRES_IN=7d

# ───── Mail ─────
# console: 実送信せず標準出力にメール内容を出す(ローカル開発のデフォルト)
# ses:     Amazon SES で実送信(本番)
MAIL_DRIVER=console
MAIL_FROM=no-reply@nagareyama-jc.com
MAIL_FROM_NAME=流山JC 出欠管理

# ───── Amazon SES (MAIL_DRIVER=ses のときのみ必要) ─────
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
