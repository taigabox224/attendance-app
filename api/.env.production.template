# =============================================================================
# 本番環境用 .env テンプレート (attendance-app)
# =============================================================================
#
# このファイルを api/.env にコピーして埋めてください。
# 「★ 担当者で設定」 → インフラ担当者が値を生成・取得
# 「☆ 開発者から受領」 → 村岡 (eishin-muraoka@dimage.co.jp) から別途共有
#
# cp api/.env.production.template api/.env
#
# .env は git 管理外。サーバ上の安全な場所に置き、必要に応じて systemd の
# EnvironmentFile や PM2 ecosystem の env_file 経由で読み込んでください。
# =============================================================================


# ───── Server ─────
PORT=3000
NODE_ENV=production
# ★ 担当者で設定: 本番のフロント公開 URL (認証メール内のリンクに埋め込む)
#    例: https://attend.example-jc.com
APP_URL=


# ───── Database ─────
# SQLite 単一ファイル。永続ボリュームに配置してください。
# 例: /var/lib/attendance-app/app.db
# 相対パスにする場合は node プロセスの cwd を api/ にして file:./data/app.db
DATABASE_URL=file:/var/lib/attendance-app/app.db


# ───── CORS ─────
# 同一オリジン配信 (nginx で /api/* をプロキシ) の場合は空欄で OK。
# 別オリジン (api.example.com と app.example.com を分ける) の場合は
# フロント URL をカンマ区切りで設定。例: https://attend.example-jc.com
CORS_ORIGINS=


# ───── JWT ─────
# ★ 担当者で設定: openssl で 128 文字の hex を生成し、ここに貼る
#    生成コマンド:  openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d


# ───── Mail (Amazon SES) ─────
# 本番は ses 固定。テスト用に console (標準出力に出力) に切り替え可能。
MAIL_DRIVER=ses
# SES で DKIM 認証済みのドメインの送信元アドレス
MAIL_FROM=no-reply@nagareyama-jc.com
MAIL_FROM_NAME=流山JC 出欠管理


# ───── Amazon SES 認証情報 (MAIL_DRIVER=ses のとき必須) ─────
AWS_REGION=ap-northeast-1
# ★ 担当者で設定: SES 送信権限のある IAM ユーザーの key。
#    EC2/Lightsail インスタンスロールを使う場合はこの 2 つは未設定で OK
#    (AWS SDK が自動的にインスタンスメタデータ経由で取得する)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ───── Default seed accounts (npm run seed:defaults 実行時のみ参照) ─────
# 初回 DB セットアップ時に 3 つの sysadmin アカウントを作成する。
# 一度 seed すれば値は不要になるので、その後は空欄にしても削除しても OK。
#
# ☆ 開発者から受領: 以下 8 つの値は村岡から別途セキュアチャネル経由で共有
#
# システム運用専用 (人間ではない、is_system_account=1 で扱われる)
SEED_SYSADMIN_EMAIL=sysadmin@nagareyama-jc.com
SEED_SYSADMIN_PASSWORD=nagareyamajc2026

