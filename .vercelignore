# Vercel は web/dist だけを配信する。それ以外を除外。
# パターンは .gitignore と同じ — 先頭の `/` でリポジトリ root 限定にしないと、
# `package.json` のような名前が web/package.json まで巻き込んでしまう。

# バックエンド (Lightsail にデプロイ予定、Vercel は触らない)
# 17 個の .ts を Vercel が serverless function と誤認識して 12 関数上限を
# 超えてしまうのを防ぐ。
/api/

# ドキュメント類 (リポジトリ閲覧用、配信不要)
/docs/
/MANUAL.md
/MANUAL.pdf
/README.md
/CLAUDE.md
/PRODUCTION.md
/AUTH_FEATURE.md
/INFRA_REQUEST.md
/DEPLOYMENT.md

# 開発スクリプト (puppeteer 等)
/scripts/

# Phase 1 プロトタイプ (リファレンス用、配信しない)
web/legacy/

# 開発専用パッケージ (root だけ。web/package.json は build に必要なので残す)
/node_modules/
/package.json
/package-lock.json

# 環境変数 (念のため)
.env
.env.local
.env.production
